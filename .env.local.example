# Supabase — get from https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Kimi K2 AI (Moonshot AI) — get from https://platform.moonshot.cn
KIMI_API_KEY=your_moonshot_api_key

# EmailJS — for contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# N8N webhook (optional — falls back to direct Kimi API if not set)
N8N_CHAT_WEBHOOK_URL=https://your-n8n.app/webhook/chat
